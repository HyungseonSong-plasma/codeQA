{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeqa:qa:architecture-self-diagnostic:v0.1",
  "title": "B8 exact-head source-bound self-diagnostic projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "source_identity",
    "assessment_id",
    "coverage",
    "unknowns",
    "decision",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "kind": {
      "enum": [
        "architecture_signals",
        "question_opportunities"
      ]
    },
    "source_identity": {
      "type": "object",
      "required": [
        "snapshot_sha",
        "inventory_id",
        "metrics_id",
        "role_policy_sha256",
        "dependency_profile_id"
      ],
      "properties": {
        "snapshot_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "assessment_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "coverage": {
      "type": "object"
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "decision": {
      "const": "NOT_EVALUATED"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "architecture_signals"
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "required": [
                "signal_id",
                "measurement",
                "derivation_rule",
                "source_witnesses",
                "benign_counterhypothesis"
              ],
              "properties": {
                "source_witnesses": {
                  "type": "array",
                  "minItems": 1
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "question_opportunities"
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "required": [
                "opportunity_id",
                "originating_signal_ids",
                "source_witnesses",
                "benign_counterhypothesis",
                "alternatives",
                "decision"
              ],
              "properties": {
                "originating_signal_ids": {
                  "type": "array",
                  "minItems": 1
                },
                "source_witnesses": {
                  "type": "array",
                  "minItems": 1
                },
                "alternatives": {
                  "type": "array",
                  "contains": {
                    "const": "KEEP"
                  }
                },
                "decision": {
                  "const": "NOT_EVALUATED"
                }
              }
            }
          }
        }
      }
    }
  ]
}
