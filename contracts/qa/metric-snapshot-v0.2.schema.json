{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeqa:qa:metric-snapshot:v0.2",
  "title": "codeQA evidence-aware per-rule metric snapshot v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "source",
    "rules",
    "unsupported_principles",
    "interpretation"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit_sha",
        "files",
        "coverage",
        "unprocessed"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "coverage": {
          "enum": [
            "complete",
            "partial",
            "none"
          ]
        },
        "unprocessed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "reason"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "principle",
          "engine",
          "profile",
          "metric",
          "denominator",
          "evidence_status",
          "limitations",
          "observations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "principle": {
            "pattern": "^P[1-8]$",
            "type": "string"
          },
          "engine": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "profile": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "fingerprint"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "fingerprint": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "metric": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "unit"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "unit": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "denominator": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "evidence_status": {
            "enum": [
              "MEASURED",
              "LIMITED",
              "NOT_EVALUATED"
            ]
          },
          "limitations": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "observations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "subject_key",
                "value",
                "review_required",
                "line",
                "evidence_id",
                "producer"
              ],
              "properties": {
                "path": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "subject_key": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "number"
                },
                "review_required": {
                  "type": "boolean"
                },
                "line": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "evidence_id": {
                  "type": "string",
                  "minLength": 1
                },
                "producer": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "unsupported_principles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^P[1-8]$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "interpretation": {
      "const": "MEASURED_RULE_OBSERVATIONS_NOT_GENERAL_QUALITY"
    }
  }
}
