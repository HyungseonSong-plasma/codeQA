{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeqa:policy:gate:v0.1",
  "title": "Strict codeQA Evidence Gate v0.1",
  "description": "Additive, explicitly pinned scoped policy. Only source-backed admissible evidence can grant a Gate PASS.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "snapshot_id",
    "source_files",
    "requirements"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "scope",
          "tool",
          "rule_ids",
          "predicate",
          "exceptions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "tool": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version",
              "binary_sha256",
              "adapter_version",
              "invocation_sha256",
              "ruleset_sha256",
              "exit_classifier"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "binary_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "adapter_version": {
                "type": "string",
                "minLength": 1
              },
              "invocation_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "ruleset_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "exit_classifier": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "rule_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "predicate": {
            "enum": [
              "STATIC_NO_HIGH_FINDINGS",
              "TYPE_NO_ERRORS",
              "FORMAL_IMPLEMENTATION_VERIFIED"
            ]
          },
          "exceptions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "rule_id",
                "ticket",
                "approved_by",
                "reason",
                "expires_at"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
                },
                "rule_id": {
                  "type": "string",
                  "minLength": 1
                },
                "ticket": {
                  "type": "string",
                  "minLength": 1
                },
                "approved_by": {
                  "type": "string",
                  "minLength": 1
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "expires_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      }
    }
  }
}
