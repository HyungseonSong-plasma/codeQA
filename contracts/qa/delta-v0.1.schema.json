{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeqa:qa:delta:v0.1",
  "title": "codeQA QA Delta v0.1",
  "description": "Descriptive delta on comparable rule observations; not evidence of defect counts or quality improvement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "baseline_snapshot_id",
    "candidate_snapshot_id",
    "engine",
    "profile",
    "analyzed_paths",
    "interpretation",
    "rule_deltas"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "baseline_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fingerprint"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "analyzed_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "interpretation": {
      "const": "descriptive_review_counts_only"
    },
    "rule_deltas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "metric",
          "unit",
          "baseline_review_count",
          "candidate_review_count",
          "review_count_delta"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "baseline_review_count": {
            "type": "integer",
            "minimum": 0
          },
          "candidate_review_count": {
            "type": "integer",
            "minimum": 0
          },
          "review_count_delta": {
            "type": "integer"
          }
        }
      }
    }
  }
}
