{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeqa:evidence:external-envelope:v0.1",
  "title": "External Evidence Envelope v0.1 - source-attested, typed and admission-gated",
  "description": "Structural validation only; independent artifact/source/tool integrity and coverage checks are required before any Gate PASS. Not an extension of CCG or QA Result v0.1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "tool",
    "execution",
    "scope",
    "raw_artifact",
    "observations"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "tool": {
      "$ref": "#/$defs/tool"
    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "raw_artifact": {
      "$ref": "#/$defs/raw_artifact"
    },
    "observations": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/static_finding"
          },
          {
            "$ref": "#/$defs/type_diagnostic"
          },
          {
            "$ref": "#/$defs/formal_proof"
          }
        ]
      }
    }
  },
  "$defs": {
    "source_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "skipped_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "reason"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "binary_sha256",
        "adapter_version",
        "invocation_sha256",
        "ruleset_sha256",
        "exit_classifier"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "binary_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "invocation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ruleset_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "exit_classifier": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "exit_code",
        "exit_classification"
      ],
      "properties": {
        "state": {
          "enum": [
            "COMPLETED",
            "FAILED",
            "TIMED_OUT",
            "CANCELLED",
            "UNKNOWN"
          ]
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "exit_classification": {
          "enum": [
            "VALID_RESULT",
            "EXECUTION_FAILURE",
            "UNDETERMINED"
          ]
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_files",
        "scanned_files",
        "skipped_files",
        "parser_errors",
        "required_rules",
        "evaluated_rules"
      ],
      "properties": {
        "expected_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source_file"
          }
        },
        "scanned_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_file"
          }
        },
        "skipped_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/skipped_file"
          }
        },
        "parser_errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/skipped_file"
          }
        },
        "required_rules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evaluated_rules": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "raw_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "sha256",
        "media_type"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "static_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "rule_id",
        "severity",
        "path",
        "line",
        "message",
        "native_status"
      ],
      "properties": {
        "kind": {
          "const": "STATIC_FINDING"
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "CRITICAL",
            "HIGH",
            "MEDIUM",
            "LOW",
            "INFO"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "native_status": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "type_diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "rule_id",
        "severity",
        "path",
        "line",
        "message",
        "native_status"
      ],
      "properties": {
        "kind": {
          "const": "TYPECHECK_DIAGNOSTIC"
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "ERROR",
            "WARNING",
            "INFO"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "native_status": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "formal_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "obligation_id",
        "path",
        "source_sha256",
        "native_status",
        "assumptions",
        "counterexample_sha256"
      ],
      "properties": {
        "kind": {
          "const": "FORMAL_PROOF_RESULT"
        },
        "obligation_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "native_status": {
          "type": "string",
          "minLength": 1
        },
        "assumptions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "counterexample_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
