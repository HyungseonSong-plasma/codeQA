{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeqa:qa:architecture-inventory:v0.1",
  "title": "codeQA Architecture Source Inventory v0.1 (evidence only)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_identity",
    "status",
    "source_scope",
    "coverage",
    "unknown_reasons",
    "files",
    "directories",
    "packages",
    "language_coverage",
    "package_metadata_paths",
    "top_level_groups",
    "limitations",
    "inventory_id"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_commit_sha",
        "role_policy_sha256",
        "name_hint_rules_sha256"
      ],
      "properties": {
        "repository_commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "role_policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "name_hint_rules_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "status": {
      "enum": [
        "EVIDENCE_ONLY",
        "INCOMPLETE"
      ]
    },
    "source_scope": {
      "type": "string",
      "minLength": 1
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tracked_total",
        "read",
        "missing",
        "excluded",
        "failed",
        "symlink_not_followed",
        "generated",
        "parsed"
      ],
      "properties": {
        "tracked_total": {
          "type": "integer",
          "minimum": 0
        },
        "read": {
          "type": "integer",
          "minimum": 0
        },
        "missing": {
          "type": "integer",
          "minimum": 0
        },
        "excluded": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "symlink_not_followed": {
          "type": "integer",
          "minimum": 0
        },
        "generated": {
          "type": "integer",
          "minimum": 0
        },
        "parsed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "unknown_reasons": {
      "$ref": "#/$defs/counts"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "source_sha256",
          "read_state",
          "language",
          "parser_status",
          "ownership_class",
          "declared_role",
          "name_hints",
          "generated",
          "evidence_class"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "source_sha256": {
            "anyOf": [
              {
                "$ref": "#/$defs/sha256"
              },
              {
                "type": "null"
              }
            ]
          },
          "read_state": {
            "enum": [
              "READ",
              "MISSING",
              "EXCLUDED",
              "READ_FAILED",
              "SYMLINK_NOT_FOLLOWED"
            ]
          },
          "language": {
            "enum": [
              "python",
              "rust",
              "cpp_family",
              "other"
            ]
          },
          "parser_status": {
            "const": "NOT_EVALUATED"
          },
          "ownership_class": {
            "enum": [
              "POLICY_DECLARED",
              "NAME_HINT",
              "UNCLASSIFIED",
              "AMBIGUOUS"
            ]
          },
          "declared_role": {
            "type": [
              "string",
              "null"
            ]
          },
          "name_hints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "generated": {
            "type": "boolean"
          },
          "evidence_class": {
            "enum": [
              "OBSERVED",
              "DECLARED_POLICY",
              "PROXY_INFERENCE"
            ]
          }
        }
      }
    },
    "directories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "parent",
          "direct_files",
          "descendant_files",
          "children"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "parent": {
            "type": [
              "string",
              "null"
            ]
          },
          "direct_files": {
            "type": "integer",
            "minimum": 0
          },
          "descendant_files": {
            "type": "integer",
            "minimum": 0
          },
          "children": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "init_path",
          "init_read_state",
          "module_files",
          "no_other_python_modules",
          "evidence_class"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "init_path": {
            "type": "string"
          },
          "init_read_state": {
            "type": "string"
          },
          "module_files": {
            "type": "integer",
            "minimum": 0
          },
          "no_other_python_modules": {
            "type": "boolean"
          },
          "evidence_class": {
            "const": "OBSERVED"
          }
        }
      }
    },
    "language_coverage": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "tracked",
          "parser_status"
        ],
        "properties": {
          "tracked": {
            "type": "integer",
            "minimum": 0
          },
          "read": {
            "type": "integer",
            "minimum": 0
          },
          "not_read": {
            "type": "integer",
            "minimum": 0
          },
          "parser_status": {
            "const": "NOT_EVALUATED"
          }
        }
      }
    },
    "package_metadata_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "top_level_groups": {
      "$ref": "#/$defs/counts"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "inventory_id": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
