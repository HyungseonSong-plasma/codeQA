{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeqa:adapter:capability:v0.1",
  "title": "codeQA Language Adapter capability declaration v0.1",
  "description": "Versioned description of verified analyzer support; not an execution result or quality verdict.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter",
    "input",
    "output",
    "features",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "adapter": {
      "$ref": "#/$defs/adapter"
    },
    "input": {
      "$ref": "#/$defs/input"
    },
    "output": {
      "$ref": "#/$defs/output"
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/feature"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 5
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "stringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "language",
        "parser"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "$ref": "#/$defs/identifier"
        },
        "parser": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "execution"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "execution": {
              "enum": [
                "syntax_only",
                "other_static",
                "executes_target"
              ]
            }
          }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "snapshot_identity",
        "acquisition",
        "selection",
        "extensions",
        "configuration"
      ],
      "properties": {
        "format": {
          "enum": [
            "path_to_utf8_source_mapping",
            "source_tree",
            "other"
          ]
        },
        "snapshot_identity": {
          "enum": [
            "caller_supplied_immutable_id",
            "adapter_captured_immutable_id"
          ]
        },
        "acquisition": {
          "enum": [
            "caller_supplied",
            "adapter_acquired"
          ]
        },
        "selection": {
          "enum": [
            "caller_supplied_paths_only",
            "configurable_includes_excludes"
          ]
        },
        "extensions": {
          "$ref": "#/$defs/stringArray"
        },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "supported",
            "unsupported"
          ],
          "properties": {
            "supported": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "unsupported": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graph_contract",
        "node_kinds",
        "edge_kinds",
        "coverage_statuses",
        "resolution_statuses",
        "stable_on_identical_input"
      ],
      "properties": {
        "graph_contract": {
          "const": "CCG:0.1"
        },
        "node_kinds": {
          "$ref": "#/$defs/stringArray"
        },
        "edge_kinds": {
          "$ref": "#/$defs/stringArray"
        },
        "coverage_statuses": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "enum": [
              "complete",
              "partial",
              "none"
            ]
          },
          "allOf": [
            {
              "contains": {
                "const": "complete"
              }
            },
            {
              "contains": {
                "const": "partial"
              }
            },
            {
              "contains": {
                "const": "none"
              }
            }
          ]
        },
        "resolution_statuses": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "enum": [
              "resolved",
              "unresolved"
            ]
          },
          "allOf": [
            {
              "contains": {
                "const": "resolved"
              }
            },
            {
              "contains": {
                "const": "unresolved"
              }
            }
          ]
        },
        "stable_on_identical_input": {
          "type": "boolean"
        }
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "evidence"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "enum": [
            "SUPPORTED",
            "PARTIAL",
            "NOT_EVALUATED"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 5
        }
      }
    }
  }
}
