{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeqa:source-selection:v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot",
    "discovery",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit_sha"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 3
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "inventory_complete"
      ],
      "properties": {
        "method": {
          "const": "caller_explicit_path_inventory"
        },
        "inventory_complete": {
          "type": "boolean"
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "language",
          "selection",
          "category"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "selection": {
            "enum": [
              "included",
              "excluded"
            ]
          },
          "category": {
            "enum": [
              "product",
              "test",
              "generated",
              "vendor",
              "other"
            ]
          },
          "exclusion_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
