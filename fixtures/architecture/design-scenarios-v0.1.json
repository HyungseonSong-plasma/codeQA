{
  "schema_version": "0.1",
  "design_id": "codeqa.architecture-assessment-design.v0.1",
  "phase": "DESIGN_ONLY",
  "approval_status": "PROPOSED",
  "authority": {
    "frozen_repository_root": "profiles/repository-layout.json",
    "package_structure": "docs/codeqa-package-architecture.md",
    "role_policy": "profiles/semantic-directory-roles-v0.1.json",
    "evidence_sources": [
      "src/codeqa/evaluation/domain_inventory.py",
      "src/codeqa/evaluation/semantic_architecture.py",
      "src/codeqa/evaluation/semantic_layout.py",
      "src/codeqa/evaluation/impact.py",
      "src/codeqa/adapters/python_dependencies.py"
    ]
  },
  "ownership": {
    "core": {
      "path": "src/codeqa/core",
      "may_import": [],
      "responsibility": "Immutable language-neutral scenario, evidence, coverage, and assessment records"
    },
    "adapters": {
      "path": "src/codeqa/adapters",
      "may_import": [
        "core"
      ],
      "responsibility": "Language-specific syntax and source correspondence, not architecture verdicts"
    },
    "evaluation": {
      "path": "src/codeqa/evaluation",
      "may_import": [
        "core"
      ],
      "responsibility": "Pure measurements, scenarios, migration candidates, and evidence-bounded comparative assessments"
    },
    "pipeline": {
      "path": "src/codeqa/pipeline",
      "may_import": [
        "core",
        "adapters",
        "evaluation",
        "infrastructure"
      ],
      "responsibility": "Compose declared input evidence and opt-in architecture analysis"
    },
    "governance": {
      "path": "src/codeqa/governance",
      "may_import": [
        "infrastructure"
      ],
      "responsibility": "Repository policy integrity; does not replace analyzer assessment"
    },
    "infrastructure": {
      "path": "src/codeqa/infrastructure",
      "may_import": [],
      "responsibility": "Local Git/resource plumbing only; no domain verdict"
    }
  },
  "proposed_components": [
    {
      "owner": "core",
      "path": "src/codeqa/core/architecture.py",
      "purpose": "Typed immutable scenario and result records; never read Git or import Python AST"
    },
    {
      "owner": "evaluation",
      "path": "src/codeqa/evaluation/architecture/inventory.py",
      "purpose": "Read-only observed folder/package/role inventory; reuse existing domain inventory"
    },
    {
      "owner": "evaluation",
      "path": "src/codeqa/evaluation/architecture/metrics.py",
      "purpose": "Coverage-normalized static dependency and cohesion/coupling proxies"
    },
    {
      "owner": "evaluation",
      "path": "src/codeqa/evaluation/architecture/scenarios.py",
      "purpose": "Virtual path relocation and deterministic alternative projection; no writes"
    },
    {
      "owner": "evaluation",
      "path": "src/codeqa/evaluation/architecture/migration.py",
      "purpose": "Import, distribution, resource and public API change candidates"
    },
    {
      "owner": "evaluation",
      "path": "src/codeqa/evaluation/architecture/assessment.py",
      "purpose": "Evidence-bounded comparison; never claim unobserved semantic improvement"
    },
    {
      "owner": "pipeline",
      "path": "src/codeqa/pipeline/architecture.py",
      "purpose": "Opt-in composition; no GitHub mutation"
    },
    {
      "owner": "pipeline",
      "path": ".github/scripts/architecture_audit.py",
      "purpose": "Caller-owned exact-checkout CI runner; creates versioned artifacts"
    }
  ],
  "comparison": {
    "evidence_classes": [
      "OBSERVED",
      "DECLARED_POLICY",
      "PROXY_INFERENCE",
      "HUMAN_REVIEW"
    ],
    "decisions": [
      "PREFER",
      "KEEP",
      "REVIEW_REQUIRED",
      "INSUFFICIENT_EVIDENCE"
    ],
    "required_record_fields": [
      "scenario_id",
      "snapshot_sha",
      "analyzer_version",
      "profile_sha256",
      "source_coverage",
      "source_witnesses",
      "metrics_with_denominators",
      "unknowns",
      "migration_impact",
      "tradeoffs",
      "decision",
      "decision_reasons",
      "review_question",
      "originating_signals",
      "candidate_decision_question",
      "derivation_rule",
      "counterhypotheses"
    ],
    "fail_closed_on": [
      "unknown_external_consumers",
      "dynamic_imports",
      "unresolved_language_parsers",
      "policy_conflict",
      "noncomparable_coverage"
    ],
    "principle": "A current policy match cannot by itself certify optimal architecture or semantic cohesion",
    "required_signal_fields": [
      "signal_id",
      "family",
      "scope",
      "source_witnesses",
      "measurements_and_denominators",
      "coverage",
      "unknowns",
      "counterhypotheses",
      "severity_or_opportunity",
      "derivation_rule"
    ],
    "required_opportunity_fields": [
      "opportunity_id",
      "originating_signals",
      "affected_owners",
      "source_witnesses",
      "diagnostic_reason",
      "candidate_decision_question",
      "plausible_alternatives",
      "counterarguments",
      "missing_evidence",
      "confidence_limitations"
    ]
  },
  "prohibitions": [
    "production_source_move",
    "rename",
    "adapter_relocation",
    "public_api_change",
    "ccg_v01_change",
    "qa_result_v01_change",
    "auto_migration",
    "hardcoded_preselected_questions"
  ],
  "design_intent": "EVIDENCE_FIRST_QUESTION_DISCOVERY_NOT_PRESELECTED_ARCHITECTURE_QUESTIONS",
  "discovery": {
    "requires_preseeded_question": false,
    "applies_to_arbitrary_repository": true,
    "minimum_source_evidence": [
      "immutable_source_identity",
      "observed_structure_and_coverage",
      "verified_static_relationship_witnesses",
      "declared_vs_observed_boundaries",
      "unknown_and_unresolved_evidence"
    ],
    "stages": [
      "extract_source_facts",
      "detect_structural_signals",
      "assemble_evidence_packs",
      "generate_bounded_opportunity_hypotheses",
      "surface_question_opportunities_to_chatgpt",
      "derive_relevant_alternative_layouts",
      "evaluate_counterfactuals_with_compatibility_gates",
      "issue_conditional_recommendation_or_insufficient_evidence"
    ],
    "signal_families": [
      {
        "id": "RESPONSIBILITY_SCATTER",
        "evidence": [
          "classified_source_owners",
          "cross_role_witnesses",
          "unclassified_ratio"
        ],
        "hypothesis": "A concern may be split across unrelated package roles",
        "counterexample": "Intentionally layered concern; name similarity is not cohesion"
      },
      {
        "id": "BOUNDARY_PRESSURE",
        "evidence": [
          "inbound_outbound_edges",
          "static_cycles",
          "reexported_public_surface",
          "coverage"
        ],
        "hypothesis": "A package boundary may be poorly located or overly exposed",
        "counterexample": "High-use stable extension interface with deliberate direction"
      },
      {
        "id": "CHANGE_SURFACE_PRESSURE",
        "evidence": [
          "reverse_import_impact",
          "file_and_symbol_distribution",
          "independent_churn_when_available"
        ],
        "hypothesis": "Change propagation may suggest moving a responsibility boundary",
        "counterexample": "No independent change history or external consumers"
      },
      {
        "id": "LANGUAGE_ISOLATION_PRESSURE",
        "evidence": [
          "language_specific_dependencies",
          "shared_contract_references",
          "capability_coverage"
        ],
        "hypothesis": "Language implementations may benefit from isolation or family grouping",
        "counterexample": "Only one language implemented; empty future packages are not evidence"
      },
      {
        "id": "DECLARED_OBSERVED_MISMATCH",
        "evidence": [
          "declared_role_constraints",
          "observed_import_edges",
          "missing_relationships"
        ],
        "hypothesis": "Present roles may not explain observed dependencies",
        "counterexample": "A declared policy violation does not prove a better replacement layout"
      }
    ],
    "required_signal_fields": [
      "signal_id",
      "family",
      "scope",
      "source_witnesses",
      "measurements_and_denominators",
      "coverage",
      "unknowns",
      "counterhypotheses",
      "severity_or_opportunity",
      "derivation_rule"
    ],
    "required_opportunity_fields": [
      "opportunity_id",
      "originating_signals",
      "affected_owners",
      "source_witnesses",
      "diagnostic_reason",
      "candidate_decision_question",
      "plausible_alternatives",
      "counterarguments",
      "missing_evidence",
      "confidence_limitations"
    ],
    "emission_policy": {
      "no_signal": "EMPTY_OPPORTUNITIES_NOT_FALSE_PASS",
      "insufficient_evidence": "SURFACE_HYPOTHESIS_AND_UNKNOWN_WITHOUT_PREFERENCE",
      "candidate_question": "DERIVE_FROM_MEASURED_SIGNALS_NOT_FROM_REPOSITORY_NAME_OR_TEST_CASE",
      "zero_or_more_questions": true,
      "no_forced_naming_or_adapter_question": true,
      "no_mutation_or_migration_authority": true,
      "never_claim_optimal_from_policy_compliance": true
    },
    "anti_tautology_tests": [
      "rename_identifiers_preserving_graph",
      "same_names_different_responsibilities",
      "different_names_same_responsibility",
      "unrelated_repository_fixture",
      "no_signal_fixture",
      "conflicting_metrics",
      "unknown_external_consumers"
    ],
    "downstream_consumer": "ChatGPT receives source-grounded signals/evidence packs and MAY independently raise architecture questions. Generated question text is an advisory, never a precondition to assess architecture."
  },
  "regression_examples": [
    {
      "example_id": "L0",
      "historical_owner_question": "Is the current folder layout suitable?",
      "possible_layout_candidates": [
        "src/codeqa/core",
        "src/codeqa/adapters",
        "src/codeqa/evaluation",
        "src/codeqa/pipeline",
        "src/codeqa/governance",
        "src/codeqa/infrastructure"
      ],
      "known_evidence_needs": [
        "complete_source_tree",
        "declared_roles",
        "static_dependency_coverage"
      ],
      "evidence_status": "NOT_MEASURED_BY_DESIGN",
      "role": "REGRESSION_QUESTION_FAMILY_ONLY_NOT_ANALYZER_INPUT"
    },
    {
      "example_id": "L1",
      "historical_owner_question": "Would a bounded Naming domain package improve ownership?",
      "possible_layout_candidates": [
        "src/codeqa/naming"
      ],
      "known_evidence_needs": [
